# OpenAI API Key (required for PDF extraction and some AI operations)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration (for local LLM fallback)
OLLAMA_HOST=http://ollama:11434

# LM Studio Configuration (primary local LLM)
LM_STUDIO_HOST=http://localhost:1234
LM_STUDIO_MODEL=google/gemma-2-9b
LM_STUDIO_ENABLED=true

# Email Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@aegisai.com

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# GitHub Integration (optional, for auto-remediation)
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO_OWNER=your_org
GITHUB_REPO_NAME=your_repo

# Cloud Provider Connections
# NOTE: Cloud provider credentials (AWS, IBM Cloud, Azure, GCP) are now managed
# through the web UI (Admin > Connections) and stored encrypted in ./data/connections.json
# You no longer need to set these in environment variables!
#
# Legacy IBM Cloud config (DEPRECATED - use Connections UI instead):
# IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here
# IBM_CLOUD_REGION=us-south
# IBM_ACTIVITY_TRACKER_INSTANCE_ID=your_activity_tracker_instance_id
# IBM_MONITORING_INSTANCE_ID=your_monitoring_instance_id
# IBM_LOGS_INSTANCE_ID=your_logs_instance_id
# IBM_CLOUD_ENABLED=false

# Application Configuration
LOG_LEVEL=INFO
MOCK_MODE=true
COMPLIANCE_CHECK_INTERVAL=30

# Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_encryption_key_here

# Database (optional, for production)
DATABASE_URL=postgresql://user:password@localhost:5432/aegisai